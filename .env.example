# Alpaca API credentials (required) -- get these from your Alpaca dashboard.
# Used for both market data (src/data/market_data.py) and order placement (src/trading/).
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here

# Phone notifications via free email-to-SMS gateway (optional -- only needed by
# src/notifications/notifier.py / src/trading/run_daily.py's notify() calls).
# GMAIL_APP_PASSWORD is NOT your normal Gmail password -- Google blocks that for SMTP from
# external scripts. Generate a 16-character "App Password" at myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account first).
GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
NOTIFY_PHONE_NUMBER=5551234567
NOTIFY_CARRIER=att
