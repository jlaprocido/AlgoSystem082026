# Alpaca API credentials (required) -- get these from your Alpaca dashboard.
# Used for both market data (src/data/market_data.py) and order placement (src/trading/).
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_API_SECRET=your_alpaca_secret_here

# Push notifications via ntfy.sh (optional -- only needed by src/notifications/notifier.py /
# src/trading/run_daily.py's notify() calls). No account needed: pick any topic name (treat it
# like a shared secret -- anyone who knows it can read your notifications), then subscribe to
# that same topic in the ntfy app (iOS/Android) or at https://ntfy.sh/<topic> in a browser.
NTFY_TOPIC=your_chosen_topic_name
